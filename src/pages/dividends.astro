---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { getDividendBoard, type DividendYieldRow } from '../lib/dividends';

let rows: DividendYieldRow[] = [];
let loadError: string | null = null;
try {
  rows = (await getDividendBoard(60)).rows;
} catch (err) {
  loadError = err instanceof Error ? err.message : 'Failed to load dividend data';
}

const ratingStyle = (r: string) =>
  r === 'STRONG ENTRY' ? 'bg-green-500/20 text-green-300'
  : r === 'GOOD ENTRY' ? 'bg-emerald-500/10 text-emerald-400'
  : r === 'AVOID' ? 'bg-red-500/15 text-red-400'
  : 'bg-slate-700/40 text-slate-400';
const verdictStyle = (v: string | null) =>
  v === 'BUY' ? 'text-green-400' : v === 'SELL' ? 'text-red-400' : 'text-slate-400';
const typeStyle = (t: string | null) =>
  t === 'Special' ? 'bg-amber-500/15 text-amber-400' : 'bg-slate-700/40 text-slate-300';
const peso = (n: number, d = 2) => `₱${n.toLocaleString('en-PH', { minimumFractionDigits: d, maximumFractionDigits: d })}`;
const dps = (n: number) => peso(n, n < 1 ? 4 : 2);
const shortDate = (iso: string | null) => {
  if (!iso) return null;
  const d = new Date(iso + 'T00:00:00+08:00');
  return isNaN(d.getTime()) ? iso : d.toLocaleDateString('en-PH', { month: 'short', day: 'numeric' });
};
// Sort key for the "Upcoming" column: soonest record date first; rows with no
// upcoming payout on record get a max timestamp so they sort to the bottom.
const nextRecordMs = (iso: string | null) => {
  const t = iso ? new Date(iso + 'T00:00:00+08:00').getTime() : NaN;
  return isNaN(t) ? 8.64e15 : t;
};
const compactShares = (n: number) => n >= 1e6 ? `${(n / 1e6).toFixed(1)}M` : n >= 1e3 ? `${Math.round(n / 1e3)}K` : String(Math.round(n));
const compactPeso = (n: number) => n >= 1e6 ? `₱${(n / 1e6).toFixed(1)}M` : n >= 1e3 ? `₱${Math.round(n / 1e3)}K` : `₱${Math.round(n)}`;

// Liquidity read: is this a stock you can actually trade? Uses the ~20-session
// median turnover when known (stable), else today's turnover. ₱5M/day is the
// app's liquidity floor (STOCK_MIN_TURNOVER); below ₱1M is barely tradeable.
function liquidity(r: DividendYieldRow) {
  if (!(r.volume > 0)) return { label: 'No trades today', cls: 'text-red-400' };
  const measure = r.turnover20d ?? r.turnover;
  if (measure >= 5_000_000) return { label: 'Liquid', cls: 'text-green-400/80' };
  if (measure >= 1_000_000) return { label: 'Thin', cls: 'text-amber-400' };
  return { label: 'Very thin', cls: 'text-red-400' };
}

// Shared column template so the header and every desktop row line up. The
// `grid` display is applied per-use (md+ only) so mobile can stack into cards.
const cols = 'grid-cols-[minmax(0,1.5fr)_0.75fr_0.95fr_0.85fr_0.5fr_0.8fr_1.15fr_0.95fr_1rem] gap-2 items-center';

// Sort ranking. "Best entry" floats the buyable names to the top: strongest
// entry rating first, then an AI BUY verdict, then the entry score, then yield.
const entryRank: Record<string, number> = { 'STRONG ENTRY': 3, 'GOOD ENTRY': 2, 'WAIT': 1, 'AVOID': 0 };
const buyRank = (v: string | null) => (v === 'BUY' ? 2 : v === 'SELL' ? 0 : 1);
rows.sort((a, b) =>
  (entryRank[b.entry.rating] ?? 0) - (entryRank[a.entry.rating] ?? 0)
  || buyRank(b.verdict) - buyRank(a.verdict)
  || b.entry.score - a.entry.score
  || b.regularYieldPct - a.regularYieldPct);
---
<DashboardLayout title="Dividends">
  <style>
    details > summary { list-style: none; cursor: pointer; }
    details > summary::-webkit-details-marker { display: none; }
    .chev { transition: transform .15s ease; }
    details[open] .chev { transform: rotate(90deg); }
  </style>
  <div class="p-4 md:p-6">
    <div class="mb-6">
      <h1 class="text-2xl font-bold">💰 Dividend Tracker</h1>
      <p class="text-slate-400 text-sm mt-0.5">
        PSE stocks ranked by <strong class="text-slate-300">recurring</strong> (regular) dividend yield —
        one-off specials are shown separately so they can't fake a high yield. Tap a stock to see every
        payout, its amount, and the schedule.
      </p>
    </div>

    {loadError && <p class="text-red-400 text-sm">Could not load dividend data: {loadError}</p>}

    {!loadError && rows.length === 0 && (
      <p class="text-slate-400 text-sm">
        No dividend data yet — the disclosure sync hasn't run. It fills automatically on the daily
        schedule, or trigger it via <code class="text-slate-300">/api/cron/sync-dividends</code>.
      </p>
    )}

    {rows.length > 0 && (
      <div id="div-sort" class="flex flex-wrap items-center gap-1.5 mb-3">
        <span class="text-xs text-slate-500 mr-1">Sort by</span>
        <button type="button" data-sort="best" class="sort-btn px-2.5 py-1 rounded-md text-xs font-medium border border-slate-700 text-slate-400 hover:bg-slate-800">Best entry</button>
        <button type="button" data-sort="ryield" class="sort-btn px-2.5 py-1 rounded-md text-xs font-medium border border-slate-700 text-slate-400 hover:bg-slate-800">Recurring yield</button>
        <button type="button" data-sort="tyield" class="sort-btn px-2.5 py-1 rounded-md text-xs font-medium border border-slate-700 text-slate-400 hover:bg-slate-800">Total yield</button>
        <button type="button" data-sort="price" class="sort-btn px-2.5 py-1 rounded-md text-xs font-medium border border-slate-700 text-slate-400 hover:bg-slate-800">Price</button>
        <button type="button" data-sort="upcoming" class="sort-btn px-2.5 py-1 rounded-md text-xs font-medium border border-slate-700 text-slate-400 hover:bg-slate-800">Upcoming payout</button>
      </div>

      <div class="overflow-x-auto">
        <div id="div-rows" class="md:min-w-[940px] rounded-xl border border-slate-800 overflow-hidden">
          <div class={`hidden md:grid ${cols} bg-slate-900 text-slate-400 text-xs font-medium px-3 py-2.5`}>
            <span>Stock</span>
            <span class="text-right">Price</span>
            <span class="text-right">Recurring yield</span>
            <span class="text-right">Total yield</span>
            <span class="text-center">Payouts</span>
            <span class="text-center">AI signal</span>
            <span>Entry</span>
            <span>Upcoming</span>
            <span></span>
          </div>

          {rows.map((r) => {
            const liq = liquidity(r);
            return (
            <details
              class="border-t border-slate-800/70"
              data-entry={entryRank[r.entry.rating] ?? 0}
              data-buy={buyRank(r.verdict)}
              data-score={r.entry.score}
              data-ryield={r.regularYieldPct}
              data-tyield={r.yieldPct}
              data-price={r.price}
              data-next={nextRecordMs(r.nextRecordDate)}
            >
              <summary class="hover:bg-slate-900/50">
                {/* Mobile card (stacks instead of side-scrolling a 9-col table) */}
                <div class="md:hidden flex items-center justify-between gap-2 px-3 py-2.5 text-sm">
                  <div class="min-w-0">
                    <div class="flex items-center gap-2 flex-wrap">
                      <span class="font-semibold text-white">{r.ticker}</span>
                      <span class={`inline-block px-2 py-0.5 rounded-full text-[11px] font-medium whitespace-nowrap ${ratingStyle(r.entry.rating)}`}>{r.entry.rating}</span>
                    </div>
                    <span class="block text-xs text-slate-500 truncate">{r.companyName}</span>
                    <div class="flex flex-wrap gap-x-3 gap-y-0.5 text-[11px] mt-1 tabular-nums">
                      <span class="text-slate-300">{peso(r.price)}</span>
                      <span class="text-green-400 font-semibold">{r.regularYieldPct.toFixed(2)}% yield</span>
                      <span class={verdictStyle(r.verdict)}>AI {r.verdict ?? '—'}</span>
                      {r.nextRecordDate && <span class="text-green-300">◷ {shortDate(r.nextRecordDate)}</span>}
                    </div>
                  </div>
                  <span class="chev text-slate-500">▸</span>
                </div>
                {/* Desktop table row */}
                <div class={`hidden md:grid ${cols} px-3 py-2.5 text-sm`}>
                <span class="min-w-0">
                  <span class="font-semibold text-white">{r.ticker}</span>
                  <span class="block text-xs text-slate-500 truncate">{r.companyName}</span>
                  <span class={`block text-[11px] ${liq.cls}`}>Vol {compactShares(r.volume)} · {compactPeso(r.turnover)}/day · {liq.label}</span>
                </span>
                <span class="text-right tabular-nums text-slate-200">{peso(r.price)}</span>
                <span class="text-right tabular-nums font-semibold text-green-400">{r.regularYieldPct.toFixed(2)}%</span>
                <span class="text-right tabular-nums text-slate-300">
                  {r.yieldPct.toFixed(2)}%
                  {r.specialYieldPct >= 0.05 && <span class="block text-[11px] text-amber-400/80">+{r.specialYieldPct.toFixed(1)} special</span>}
                </span>
                <span class="text-center tabular-nums text-slate-300">{r.payments}×</span>
                <span class={`text-center text-xs font-medium ${verdictStyle(r.verdict)}`}>
                  {r.verdict ?? '—'}{r.rsi14 != null && <span class="block text-slate-500 font-normal">RSI {r.rsi14.toFixed(0)}</span>}
                </span>
                <span>
                  <span class={`inline-block px-2 py-0.5 rounded-full text-xs font-medium whitespace-nowrap ${ratingStyle(r.entry.rating)}`}>
                    {r.entry.rating}
                  </span>
                </span>
                <span class="text-xs min-w-0">
                  {r.nextRecordDate ? (
                    <>
                      <span class="text-green-300 tabular-nums whitespace-nowrap">{shortDate(r.nextRecordDate)}</span>
                      {r.nextAmount != null && <span class="block text-[11px] text-slate-500 tabular-nums">{dps(r.nextAmount)}/sh</span>}
                      <span class="block text-[11px] text-slate-600">record date</span>
                    </>
                  ) : (
                    <span class="text-slate-600">—</span>
                  )}
                </span>
                <span class="chev text-slate-500 text-center">▸</span>
                </div>
              </summary>

              <div class="px-3 pb-4 pt-1 bg-slate-900/30 text-sm">
                <div class="flex flex-wrap gap-x-6 gap-y-1 text-xs text-slate-400 mb-3">
                  <span>Price <span class="text-slate-200 tabular-nums">{peso(r.price)}</span></span>
                  <span>Activity <span class={`tabular-nums ${liq.cls}`}>{compactShares(r.volume)} sh · {compactPeso(r.turnover)} today{r.turnover20d != null && <span class="text-slate-400"> · {compactPeso(r.turnover20d)}/day avg</span>} · {liq.label}</span></span>
                  <span>Recurring <span class="text-green-400 tabular-nums">{peso(r.regularTtmDps)}/sh · {r.regularYieldPct.toFixed(2)}%</span></span>
                  {r.specialYieldPct >= 0.05 && <span>Special <span class="text-amber-400 tabular-nums">{r.specialYieldPct.toFixed(2)}%</span></span>}
                  <span>Total 12-mo <span class="text-slate-200 tabular-nums">{dps(r.ttmDps)}/sh · {r.yieldPct.toFixed(2)}%</span></span>
                </div>

                <p class="text-xs text-slate-400 mb-2">
                  <strong class="text-slate-200">{r.payments}</strong> payout{r.payments === 1 ? '' : 's'} in the last 12 months
                  {r.totalEvents > r.payments && <span> · {r.totalEvents} on record</span>}.
                  {r.nextRecordDate && (
                    <span class="text-green-400"> Next: record {r.nextRecordDate}{r.nextPaymentDate && <span>, pays {r.nextPaymentDate}</span>}{r.nextAmount != null && <span> ({dps(r.nextAmount)}/sh)</span>}.</span>
                  )}
                </p>

                <div class="overflow-x-auto rounded-lg border border-slate-800">
                  <table class="w-full text-xs">
                    <thead>
                      <tr class="text-left text-slate-500 bg-slate-900/60">
                        <th class="px-3 py-1.5 font-medium">Record date</th>
                        <th class="px-3 py-1.5 font-medium">Type</th>
                        <th class="px-3 py-1.5 font-medium text-right">Amount /share</th>
                        <th class="px-3 py-1.5 font-medium">Payment date</th>
                      </tr>
                    </thead>
                    <tbody>
                      {r.history.map((h) => (
                        <tr class={`border-t border-slate-800/60 ${h.isUpcoming ? 'bg-green-500/5' : ''}`}>
                          <td class="px-3 py-1.5 whitespace-nowrap text-slate-300">
                            {h.recordDate ?? '—'}
                            {h.isUpcoming && <span class="ml-1.5 inline-block px-1.5 rounded bg-green-500/20 text-green-300 text-[10px]">upcoming</span>}
                          </td>
                          <td class="px-3 py-1.5">
                            <span class={`inline-block px-1.5 py-0.5 rounded text-[10px] font-medium ${typeStyle(h.divType)}`}>{h.divType ?? 'Regular'}</span>
                          </td>
                          <td class="px-3 py-1.5 text-right tabular-nums text-slate-200">{dps(h.amount)}</td>
                          <td class="px-3 py-1.5 whitespace-nowrap text-slate-400">{h.paymentDate ?? '—'}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>

                {r.entry.reasons.length > 0 && (
                  <p class="text-[11px] text-slate-500 mt-2">Entry: {r.entry.reasons.join(' · ')}</p>
                )}
              </div>
            </details>
            );
          })}
        </div>
      </div>
    )}

    <div class="text-xs text-slate-500 mt-6 space-y-1">
      <p>• <strong class="text-slate-400">Recurring yield</strong> counts only Regular dividends (the sustainable payout); Special one-offs are shown separately and excluded from ranking + the entry rating.</p>
      <p>• To receive a dividend you must own the stock BEFORE its ex-date (about 1 trading day before the record date). The price usually drops by roughly the dividend on the ex-date — buying just for the payout is not free money.</p>
      <p>• <strong class="text-slate-400">Activity</strong> = shares + peso value traded today (and ~20-day average when known). <span class="text-green-400/80">Liquid</span> ≥ ₱5M/day, <span class="text-amber-400">Thin</span> ₱1–5M, <span class="text-red-400">Very thin / no trades</span> — a fat yield on a barely-traded stock is a trap you can't easily exit.</p>
      <p>• A very high yield can also be a trap: the market may be pricing in a dividend cut. That's why SELL-signal names are marked AVOID.</p>
      <p class="text-slate-600 pt-2 text-center">Data from PSE Edge disclosures. This is not financial advice.</p>
    </div>
  </div>

  <script>
    const container = document.getElementById('div-rows');
    const toolbar = document.getElementById('div-sort');
    if (container && toolbar) {
      const num = (el: Element, k: string) => parseFloat(el.getAttribute(k) || '0') || 0;
      const comparators: Record<string, (a: Element, b: Element) => number> = {
        best: (a, b) =>
          num(b, 'data-entry') - num(a, 'data-entry') ||
          num(b, 'data-buy') - num(a, 'data-buy') ||
          num(b, 'data-score') - num(a, 'data-score') ||
          num(b, 'data-ryield') - num(a, 'data-ryield'),
        ryield: (a, b) => num(b, 'data-ryield') - num(a, 'data-ryield'),
        tyield: (a, b) => num(b, 'data-tyield') - num(a, 'data-tyield'),
        price: (a, b) => num(b, 'data-price') - num(a, 'data-price'),
        // Soonest upcoming record date first; rows with none sort to the bottom.
        upcoming: (a, b) => num(a, 'data-next') - num(b, 'data-next'),
      };
      const apply = (mode: string) => {
        const cmp = comparators[mode] || comparators.best;
        Array.from(container.querySelectorAll(':scope > details'))
          .sort(cmp)
          .forEach((row) => container.appendChild(row));
        toolbar.querySelectorAll('button').forEach((b) => {
          const active = (b as HTMLElement).dataset.sort === mode;
          b.classList.toggle('bg-slate-700', active);
          b.classList.toggle('text-white', active);
          b.classList.toggle('text-slate-400', !active);
        });
      };
      toolbar.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('button[data-sort]') as HTMLElement | null;
        if (btn?.dataset.sort) apply(btn.dataset.sort);
      });
      apply('best');
    }
  </script>
</DashboardLayout>
