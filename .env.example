# ---------------------------------------------------------------------------
# Auth — in-app Google OIDC (no third-party auth service).
# Create an OAuth 2.0 Web client in Google Cloud Console and register the
# redirect URI  <PUBLIC_ORIGIN>/auth/callback  byte for byte.
# The CalDef client can be reused: just add this app's redirect URI to it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public origin of this deployment, no trailing slash. The redirect URI is
# derived from this rather than from the request Host header.
PUBLIC_ORIGIN=https://stocks.arcitools.com
# Signs the session JWT and the short-lived OAuth flow cookie. >=32 chars.
# Rotating it signs everyone out. Generate: openssl rand -base64 48
SESSION_SECRET=
# Who may sign in. `*` = any Google account (the normal value — ArciStocks has
# a public leaderboard). A comma-separated list locks it down without a rebuild.
# Empty fails closed: nobody gets in.
STOCKS_ALLOWED_EMAILS=*
# Set to 1 ONLY for local http:// development, so the cookies are not Secure.
# STOCKS_INSECURE_COOKIES=1

# Postgres on the arcitools home stack (`arcitools-postgres-1`, database
# `stocks`, private `net_data` network — no published port). Server-only.
# Apply docs/schema.sql once before first boot.
DATABASE_URL=postgresql://stocks:PASSWORD@arcitools-postgres-1:5432/stocks

# AI Providers — app auto-picks Gemini if set, falls back to Groq
# GEMINI_API_KEY accepts ONE key or a comma-separated LIST. The free tier is
# ~20 requests/day per key, so listing several keys multiplies the daily budget;
# the app round-robins them and fails over on quota (429) before dropping to Groq.
GEMINI_API_KEY=
# Optional: override the Gemini model (default: gemini-flash-latest).
# Note: gemini-2.5-flash is closed to newly-created API keys.
GEMINI_MODEL=
# xAI Grok (api.x.ai) — a SEPARATE provider from Groq. Sits between Gemini and
# Groq in the fallback chain. Needs credits on your xAI team to serve traffic.
XAI_API_KEY=
# Optional: override the Grok model (default: grok-3)
XAI_MODEL=
GROQ_API_KEY=
# Optional: override the Groq model (default: llama-3.3-70b-versatile)
GROQ_MODEL=

# Fundamentals API (P/E, EPS, dividend yield) — PSE Edge doesn't expose these.
# Key-gated: leave blank and the app runs as before (fundamentals stay null).
# Provider: eodhd (default, symbol TICKER.PSE) or twelvedata.
# NOTE: PSE fundamentals are often a PAID add-on on these providers' plans.
FUNDAMENTALS_API_KEY=
FUNDAMENTALS_PROVIDER=eodhd

# Web Push (VAPID). Generate a keypair once: npx web-push generate-vapid-keys
PUBLIC_FCM_VAPID_KEY=        # VAPID *public* key — safe to expose to the browser
VAPID_PRIVATE_KEY=          # VAPID *private* key — server-only, never expose
VAPID_SUBJECT=mailto:you@example.com
# Shared secret guarding POST /api/push/notify so only your own cron/job can fan out pushes
PUSH_NOTIFY_SECRET=

# Owner email allowed to view the private bot admin dashboard (/dashboard/bots).
# Only this signed-in address sees the three bots' stats + transaction logs;
# everyone else is redirected. If unset the gate fails closed (nobody in).
ADMIN_EMAIL=

# Liquidity floor for PSE stocks (₱ median daily value traded over ~20 sessions).
# Below this, no bot buys / advisor suggestions / movers listing — thin names
# have fictional paper fills. 0 disables. (Crypto has its own CRYPTO_MIN_VOLUME.)
# Also the floor for the Dip Radar scanner (/dip-radar).
STOCK_MIN_TURNOVER=5000000

# Dip Radar (/dip-radar) — mean-reversion "buy the dip" detector. A stock is
# "washed out" when within BOUNCE_NEAR_LOW_PCT% of its trailing (~52wk) low, and
# "oversold" at RSI <= BOUNCE_RSI_MAX. SETUP additionally needs a MACD turn.
BOUNCE_NEAR_LOW_PCT=10
BOUNCE_RSI_MAX=35

# Dividend tracker (/dividends). Scrapes PSE Edge cash-dividend disclosures — no
# API key needed. DIVIDEND_MIN_YIELD = TTM-yield floor (%) to earn an entry
# rating. Crons (in-process): sync ~6:05pm PHT daily, STRONG-ENTRY push alerts
# 8:20am PHT weekdays. Set DISABLE_DIVIDEND_TRACKER=1 to turn both off.
DIVIDEND_MIN_YIELD=4
# DIVIDEND_SYNC_CRON=5 10 * * *      # UTC; default 6:05pm PHT daily
# DIVIDEND_ALERT_CRON=20 0 * * 1-5   # UTC; default 8:20am PHT weekdays
# DIVIDEND_SYNC_DELAY_MS=300         # politeness throttle between PSE Edge fetches
# USDPHP_RATE=58.5                   # fallback FX if the live rate lookup fails

# Signal-refresh ring sizes — the AI-call budget knobs. Per market run (2x/day
# weekdays): topActive most-traded stocks + rotate stalest liquid stocks; the
# crypto ring also runs daily at 8:30am/8:30pm PHT so coin coverage builds on
# weekends. Bigger = fuller coverage, more AI calls.
SIGNAL_REFRESH_TOP_ACTIVE=30
SIGNAL_REFRESH_ROTATE=30
SIGNAL_REFRESH_CRYPTO=15

# ---------------------------------------------------------------------------
# Billing — PayMongo (GCash, Maya, GrabPay, cards).
#
# Access is sold as a fixed period (30 or 365 days), NOT an auto-renewing card
# subscription: most PH customers pay by GCash, which cannot carry a recurring
# mandate. See src/lib/billing/plans.ts.
#
# Leave these blank and the app runs exactly as before — the pricing page still
# renders, but the Get Pro buttons return "Payments are not available right now"
# instead of half-starting a checkout.
#
# Secret key from the PayMongo dashboard. sk_test_* in development; the code
# reads the prefix to decide whether to accept test or live webhook signatures,
# so a leaked test key cannot grant access on production.
PAYMONGO_SECRET_KEY=
# Webhook signing secret, shown ONCE when you create the webhook. Not the same
# value as the secret key. Register the endpoint as:
#   <PUBLIC_ORIGIN>/api/billing/webhook   for event  checkout_session.payment.paid
PAYMONGO_WEBHOOK_SECRET=
