# Supabase
PUBLIC_SUPABASE_URL=your_supabase_project_url
PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-only — used by the leaderboard aggregation API. NEVER expose to client.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AI Providers — app auto-picks Gemini if set, falls back to Groq
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional: override the Groq model (default: llama-3.3-70b-versatile)
GROQ_MODEL=

# Fundamentals API (P/E, EPS, dividend yield) — PSE Edge doesn't expose these.
# Key-gated: leave blank and the app runs as before (fundamentals stay null).
# Provider: eodhd (default, symbol TICKER.PSE) or twelvedata.
# NOTE: PSE fundamentals are often a PAID add-on on these providers' plans.
FUNDAMENTALS_API_KEY=
FUNDAMENTALS_PROVIDER=eodhd

# Web Push (VAPID). Generate a keypair once: npx web-push generate-vapid-keys
PUBLIC_FCM_VAPID_KEY=        # VAPID *public* key — safe to expose to the browser
VAPID_PRIVATE_KEY=          # VAPID *private* key — server-only, never expose
VAPID_SUBJECT=mailto:you@example.com
# Shared secret guarding POST /api/push/notify so only your own cron/job can fan out pushes
PUSH_NOTIFY_SECRET=

# Owner email allowed to view the private bot admin dashboard (/dashboard/bots).
# Only this signed-in address sees the three bots' stats + transaction logs;
# everyone else is redirected. If unset the gate fails closed (nobody in).
ADMIN_EMAIL=

# Liquidity floor for PSE stocks (₱ median daily value traded over ~20 sessions).
# Below this, no bot buys / advisor suggestions / movers listing — thin names
# have fictional paper fills. 0 disables. (Crypto has its own CRYPTO_MIN_VOLUME.)
# Also the floor for the Dip Radar scanner (/dip-radar).
STOCK_MIN_TURNOVER=5000000

# Dip Radar (/dip-radar) — mean-reversion "buy the dip" detector. A stock is
# "washed out" when within BOUNCE_NEAR_LOW_PCT% of its trailing (~52wk) low, and
# "oversold" at RSI <= BOUNCE_RSI_MAX. SETUP additionally needs a MACD turn.
BOUNCE_NEAR_LOW_PCT=10
BOUNCE_RSI_MAX=35

# Dividend tracker (/dividends). Scrapes PSE Edge cash-dividend disclosures — no
# API key needed. DIVIDEND_MIN_YIELD = TTM-yield floor (%) to earn an entry
# rating. Crons (in-process): sync ~6:05pm PHT daily, STRONG-ENTRY push alerts
# 8:20am PHT weekdays. Set DISABLE_DIVIDEND_TRACKER=1 to turn both off.
DIVIDEND_MIN_YIELD=4
# DIVIDEND_SYNC_CRON=5 10 * * *      # UTC; default 6:05pm PHT daily
# DIVIDEND_ALERT_CRON=20 0 * * 1-5   # UTC; default 8:20am PHT weekdays
# DIVIDEND_SYNC_DELAY_MS=300         # politeness throttle between PSE Edge fetches
# USDPHP_RATE=58.5                   # fallback FX if the live rate lookup fails

# Signal-refresh ring sizes — the AI-call budget knobs. Per market run (2x/day
# weekdays): topActive most-traded stocks + rotate stalest liquid stocks; the
# crypto ring also runs daily at 8:30am/8:30pm PHT so coin coverage builds on
# weekends. Bigger = fuller coverage, more AI calls.
SIGNAL_REFRESH_TOP_ACTIVE=30
SIGNAL_REFRESH_ROTATE=30
SIGNAL_REFRESH_CRYPTO=15
